    "/api/produtos/listagem": {
      "get": {
        "description": "Público. Apenas produtos com `status = true`, com suas imagens. Filtro opcional por `categoria` (UUID), ordenação por `ordenar` (`preco`, `nome`, `created_at`; padrão `created_at`) e `direcao` (`asc`/`desc`; padrão `desc`), paginada por `pagina` (padrão 1) e `limite` (padrão 20, máximo 50).",
        "operationId": "ProductController_listProducts",
        "parameters": [
          {
            "name": "categoria",
            "required": false,
            "in": "query",
            "description": "Só produtos dessa categoria (id vindo de `GET /categorias`).",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "ordenar",
            "required": false,
            "in": "query",
            "schema": {
              "default": "created_at",
              "example": "preco",
              "type": "string",
              "enum": [
                "preco",
                "nome",
                "created_at"
              ]
            }
          },
          {
            "name": "direcao",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "example": "asc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "pagina",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limite",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Traz `produtos: [{ ..., categoria, produto_imagens: [{ id, url_path, url_publica }] }]` `total`, `pagina`, `limite`, `totalPaginas` e `podeAtualizarUI`. Página além do fim devolve `produtos: []`. `categoria` é o nome da categoria, ou `null` se o produto não tem categoria ou ela está desativada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSucessoDto"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (corpo, parâmetro ou arquivo). `message` pode ser uma lista, uma entrada por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido (rate limiting).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno. O detalhe fica só no log do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          }
        },
        "summary": "Listar catálogo",
        "tags": [
          "Produtos"
        ]
      }
    },
    "/api/produtos/criar": {
      "post": {
        "description": "Requer login com nível 0 ou 1. Envio em multipart/form-data. `categoriaID` é opcional (categoria ativa; inexistente ou desativada → 400).",
        "operationId": "ProductController_createProduct",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CreateProductDto"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "imagens": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                          "type": "string",
                          "format": "binary"
                        },
                        "description": "JPEG, PNG, WebP ou GIF, até 5 MB cada (o tipo é conferido pelo conteúdo)."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado. Os campos do produto (`id`, `nome`, `preco`...) vêm no mesmo nível de `success`/`message`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSucessoDto"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (corpo, parâmetro ou arquivo). `message` pode ser uma lista, uma entrada por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado: sem cookie, token inválido/expirado ou credenciais erradas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão: nível de acesso insuficiente ou origem não autorizada (CSRF).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido (rate limiting).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErroDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Criar produto",
        "tags": [
          "Produtos"
        ]
      }
    },
