# Supabase
SUPABASE_URL=
SUPABASE_PRIVATE_KEY=      # service_role (apenas no servidor)
SUPABASE_ANON_KEY=         # usada nos fluxos de login/cadastro/recuperação
SUPABASE_JWT_SECRET=

# URL do front (CORS, verificação de Origin e link do e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:5173
# Origens extras permitidas, separadas por vírgula (ex.: https://dgconcept-catalogo.vercel.app)
CORS_ORIGINS=

NODE_ENV=development
PORT=3000

# Documentação Swagger em /docs: ligada fora de produção; defina true/false para forçar
SWAGGER_ENABLED=
